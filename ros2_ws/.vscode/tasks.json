{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon build debug",
      "type": "shell",
      "command": "bash -c 'source /opt/ros/jazzy/setup.bash && colcon build --build-base build_debug --install-base install_debug --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Debug'",
      "problemMatcher": ["$gcc"]
    }
  ]
}

