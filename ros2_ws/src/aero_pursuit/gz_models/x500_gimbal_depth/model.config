<?xml version="1.0"?>
<model>
  <name>x500 with depth camera on a 3-axis gimbal</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>PX4 x500 + OakD-Lite (RGB + depth) on a yaw/roll/pitch gimbal under the front of the
    body. Joints driven by gimbal_controller (aero_pursuit) through gz-transport. Reference: PX4
    x500_gimbal (CGO3, mono camera, driven by the PX4 gimbal manager).</description>
</model>
